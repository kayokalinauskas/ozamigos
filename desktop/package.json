{
  "name": "ozamigos-share",
  "productName": "Ozamigos",
  "version": "1.2.9",
  "description": "Transmita seu jogo para os amigos, direto de um PC para o outro.",
  "author": "Ozamigos",
  "license": "MIT",
  "main": "main.js",
  "ozamigos": {
    "servidor": "https://ozamigos.onrender.com"
  },
  "scripts": {
    "start": "electron .",
    "icone": "node build/gerar-icone.js",
    "instalador": "npm run som && electron-builder --win --publish never",
    "som": "dotnet publish som -c Release -o som/publicado"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.ozamigos.share",
    "productName": "Ozamigos",
    "publish": [
      {
        "provider": "github",
        "owner": "kayokalinauskas",
        "repo": "ozamigos"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "inicio.html",
      "inicio.js",
      "inicio.css",
      "atualizando.html",
      "atualizando.css",
      "build/icone.ico",
      "build/sora.woff2",
      "build/sora-licenca-OFL.txt",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icone.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Ozamigos-Instalador-${version}.${ext}",
      "shortcutName": "Ozamigos"
    },
    "portable": {
      "artifactName": "Ozamigos-Portatil-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "som/publicado/OzamigosSom.exe",
        "to": "som/OzamigosSom.exe"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
